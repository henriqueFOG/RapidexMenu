# RapidexMenu — HMG
# NUNCA reutilize DATABASE_URL, session secret ou credenciais de PROD aqui.
RAPIDEX_ENV=hmg
RAPIDEX_PUBLIC_URL=https://rapidexmenu-hmg.vercel.app
RAPIDEX_AUTH_MODE=native
RAPIDEX_SIGNUP_ENABLED=true
RAPIDEX_SIGNUP_MODE=open

# Banco exclusivo de HMG
DATABASE_URL=
RAPIDEX_MIGRATION_DATABASE_URL=
RAPIDEX_RUN_MIGRATIONS_DURING_BUILD=true

# Segredos exclusivos de HMG
RAPIDEX_SESSION_SECRET=
RAPIDEX_INTEGRATION_SECRET=
RAPIDEX_ADMIN_MFA_SECRET=
RAPIDEX_ADMIN_MFA_REQUIRED=false
RAPIDEX_OWNER_EMAIL=henry.francisco31@hotmail.com

# Cobrança da mensalidade fica DESATIVADA em HMG por segurança.
RAPIDEX_BILLING_MP_ACCESS_TOKEN=

# Mercado Pago: usar somente app/contas de teste ou sandbox.
RAPIDEX_MP_CLIENT_ID=
RAPIDEX_MP_CLIENT_SECRET=
MERCADO_PAGO_WEBHOOK_SECRET=

# Meta/WhatsApp: usar ativos/números de teste separados de PROD.
RAPIDEX_META_APP_ID=
RAPIDEX_META_APP_SECRET=
RAPIDEX_META_EMBEDDED_SIGNUP_CONFIG_ID=
RAPIDEX_META_SOLUTION_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v25.0

# IA/e-mail podem usar credenciais próprias de HMG.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
RESEND_API_KEY=
RAPIDEX_EMAIL_FROM=
RAPIDEX_ALERT_WEBHOOK_URL=
RAPIDEX_ALERT_WEBHOOK_SECRET=
