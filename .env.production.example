# RapidexMenu — PRODUÇÃO
RAPIDEX_ENV=production
RAPIDEX_PUBLIC_URL=https://rapidexmenu.com.br
RAPIDEX_AUTH_MODE=native
RAPIDEX_SIGNUP_ENABLED=true

# Banco exclusivo de produção
DATABASE_URL=

# Segredos exclusivos de produção
RAPIDEX_SESSION_SECRET=
RAPIDEX_INTEGRATION_SECRET=
# Nome nativo do Vercel Cron. Gere um valor aleatório com pelo menos 32 caracteres.
CRON_SECRET=
# Alias opcional para ambientes não-Vercel/legados; prefira CRON_SECRET em produção Vercel.
RAPIDEX_CRON_SECRET=

# Cobrança real da mensalidade Rapidex
RAPIDEX_BILLING_MP_ACCESS_TOKEN=

# Mercado Pago dos restaurantes — app de produção
RAPIDEX_MP_CLIENT_ID=
RAPIDEX_MP_CLIENT_SECRET=
MERCADO_PAGO_WEBHOOK_SECRET=

# Meta/WhatsApp — ativos reais de produção
RAPIDEX_META_APP_ID=
RAPIDEX_META_APP_SECRET=
RAPIDEX_META_EMBEDDED_SIGNUP_CONFIG_ID=
RAPIDEX_META_SOLUTION_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v25.0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
RESEND_API_KEY=
RAPIDEX_EMAIL_FROM=
