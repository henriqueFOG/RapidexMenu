# RapidexMenu — PRODUÇÃO
RAPIDEX_ENV=production
RAPIDEX_PUBLIC_URL=https://rapidexmenu.com.br
RAPIDEX_DOMAIN_VERIFIED=false
RAPIDEX_AUTH_MODE=native
RAPIDEX_SIGNUP_ENABLED=false
# Produção não aceita cadastro público. Estabelecimentos são criados pela Central.
RAPIDEX_SIGNUP_MODE=invite_only

# Banco exclusivo de produção
DATABASE_URL=
# Credencial proprietária somente para procedimento controlado; não reutilize no runtime.
RAPIDEX_MIGRATION_DATABASE_URL=
RAPIDEX_RUN_MIGRATIONS_DURING_BUILD=false
RAPIDEX_DATABASE_ISOLATED=false
RAPIDEX_DATABASE_APP_ROLE_VERIFIED=false
# Vercel Blob injeta este token ao conectar um Blob Store ao projeto.
BLOB_READ_WRITE_TOKEN=
# Marcador opcional usado somente pelo gate CLI quando a infraestrutura ainda não foi sincronizada localmente.
RAPIDEX_OBJECT_STORAGE_CONFIGURED=false
RAPIDEX_STORAGE_VALIDATED=false

# Segredos exclusivos de produção
RAPIDEX_SESSION_SECRET=
RAPIDEX_INTEGRATION_SECRET=
RAPIDEX_ADMIN_MFA_SECRET=
RAPIDEX_ADMIN_MFA_REQUIRED=true
RAPIDEX_OWNER_EMAIL=henry.francisco31@hotmail.com
# Nome nativo do Vercel Cron. Gere um valor aleatório com pelo menos 32 caracteres.
CRON_SECRET=
# Alias opcional para ambientes não-Vercel/legados; prefira CRON_SECRET em produção Vercel.
RAPIDEX_CRON_SECRET=
# Só marque true após validar a frequência no plano Vercel ou no agendador externo.
RAPIDEX_SCHEDULER_READY=false

# Cobrança real da mensalidade Rapidex
RAPIDEX_BILLING_MP_ACCESS_TOKEN=
RAPIDEX_BILLING_VALIDATED=false

# Mercado Pago dos restaurantes — app de produção
RAPIDEX_MP_CLIENT_ID=
RAPIDEX_MP_CLIENT_SECRET=
RAPIDEX_SELLER_PAYMENTS_VALIDATED=false
MERCADO_PAGO_WEBHOOK_SECRET=

# Meta/WhatsApp — ativos reais de produção
RAPIDEX_META_APP_ID=
RAPIDEX_META_APP_SECRET=
RAPIDEX_META_EMBEDDED_SIGNUP_CONFIG_ID=
RAPIDEX_META_SOLUTION_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v25.0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
RESEND_API_KEY=
RAPIDEX_EMAIL_FROM=
RAPIDEX_EMAIL_DELIVERY_VERIFIED=false

# Endpoint externo para alertas críticos (HTTPS). Pode apontar para um
# receiver próprio ou integração de observabilidade.
RAPIDEX_ALERT_WEBHOOK_URL=
RAPIDEX_ALERT_WEBHOOK_SECRET=

# Atestações operacionais: exigem evidência real, não apenas configuração de código.
RAPIDEX_BACKUP_RESTORE_VERIFIED=false
RAPIDEX_MONITORING_READY=false
RAPIDEX_LEGAL_READY=false
RAPIDEX_SUPPORT_READY=false
RAPIDEX_CRITICAL_ACCOUNTS_MFA_VERIFIED=false
