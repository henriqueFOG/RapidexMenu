# Ambiente
RAPIDEX_ENV=homologation
RAPIDEX_PUBLIC_URL=http://localhost:3000

# Persistencia primaria da Vercel (segredo; provisionado pelo Neon)
DATABASE_URL=

# Autenticacao comercial (producao)
# Use RAPIDEX_AUTH_MODE=native e gere um segredo aleatorio forte (32+ caracteres).
RAPIDEX_AUTH_MODE=native
RAPIDEX_SESSION_SECRET=
RAPIDEX_SIGNUP_ENABLED=true

# Acesso privado da homologacao (use RAPIDEX_AUTH_MODE=hmg-access-code na HMG)
RAPIDEX_HMG_OWNER_EMAIL=
RAPIDEX_HMG_OWNER_NAME=
RAPIDEX_HMG_ACCESS_CODE=

# Cobranca da mensalidade Rapidex (credencial da conta da plataforma, separada dos pedidos)
RAPIDEX_BILLING_MP_ACCESS_TOKEN=

# Segredo AES-GCM compartilhado pelas credenciais criptografadas das integracoes por restaurante.
RAPIDEX_INTEGRATION_SECRET=

# Mercado Pago dos restaurantes (OAuth por vendedor; NUNCA usar a credencial da plataforma para pedidos)
RAPIDEX_MP_CLIENT_ID=
RAPIDEX_MP_CLIENT_SECRET=

# WhatsApp Embedded Signup / Meta Tech Provider
# APP_SECRET e tokens sao apenas server-side. APP_ID/CONFIG_ID sao passados pelo Server Component ao SDK da Meta.
RAPIDEX_META_APP_ID=
RAPIDEX_META_APP_SECRET=
RAPIDEX_META_EMBEDDED_SIGNUP_CONFIG_ID=
# Opcional quando houver Partner/Multi-Partner Solution configurada na Meta.
RAPIDEX_META_SOLUTION_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v25.0

# E-mail transacional da plataforma
RESEND_API_KEY=
RAPIDEX_EMAIL_FROM=

# IA da operacao
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Legado/HMG single-number. Em producao multiempresa, cada restaurante usa token criptografado do Embedded Signup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Legado/piloto single-seller. Nao usar como recebimento multiempresa comercial.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
