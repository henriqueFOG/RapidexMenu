# Ambiente
RAPIDEX_ENV=homologation
RAPIDEX_PUBLIC_URL=http://localhost:3000

# Persistencia primaria da Vercel (segredo; provisionado pelo Neon)
DATABASE_URL=

# Autenticacao comercial (producao)
# Use RAPIDEX_AUTH_MODE=native e gere um segredo aleatorio forte (32+ caracteres).
RAPIDEX_AUTH_MODE=native
RAPIDEX_SESSION_SECRET=
RAPIDEX_SIGNUP_ENABLED=true

# Acesso privado da homologacao (use RAPIDEX_AUTH_MODE=hmg-access-code na HMG)
RAPIDEX_HMG_OWNER_EMAIL=
RAPIDEX_HMG_OWNER_NAME=
RAPIDEX_HMG_ACCESS_CODE=

# Cobranca da mensalidade Rapidex (credencial da conta da plataforma, separada dos pedidos)
RAPIDEX_BILLING_MP_ACCESS_TOKEN=

# Mercado Pago dos restaurantes (OAuth por vendedor; NUNCA usar a credencial da plataforma para pedidos)
RAPIDEX_MP_CLIENT_ID=
RAPIDEX_MP_CLIENT_SECRET=
RAPIDEX_INTEGRATION_SECRET=

# E-mail transacional da plataforma
RESEND_API_KEY=
RAPIDEX_EMAIL_FROM=

# Integracoes externas da operacao
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=

# Legado/piloto single-seller. Nao usar como recebimento multiempresa comercial.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
