# Desenvolvimento local
# Para HMG use .env.hmg.example; para produção use .env.production.example.
RAPIDEX_ENV=development
RAPIDEX_PUBLIC_URL=http://localhost:3000

# Persistência local/remota de desenvolvimento. Nunca copie DATABASE_URL de HMG/PROD sem intenção explícita.
DATABASE_URL=
RAPIDEX_MIGRATION_DATABASE_URL=
RAPIDEX_RUN_MIGRATIONS_DURING_BUILD=false
# Vercel Blob (opcional localmente; obrigatório na produção Vercel para imagens).
BLOB_READ_WRITE_TOKEN=

# Autenticação comercial local
RAPIDEX_AUTH_MODE=native
RAPIDEX_SESSION_SECRET=
RAPIDEX_ADMIN_MFA_SECRET=
RAPIDEX_ADMIN_MFA_REQUIRED=false
RAPIDEX_OWNER_EMAIL=henry.francisco31@hotmail.com
RAPIDEX_SIGNUP_ENABLED=true
# open em desenvolvimento/HMG; produção sempre opera como invite_only.
RAPIDEX_SIGNUP_MODE=open

# Acesso privado legado de homologação
RAPIDEX_HMG_OWNER_EMAIL=
RAPIDEX_HMG_OWNER_NAME=
RAPIDEX_HMG_ACCESS_CODE=

# Cobrança da mensalidade Rapidex. Deixe vazio fora de produção.
RAPIDEX_BILLING_MP_ACCESS_TOKEN=

# Segredo AES-GCM compartilhado pelas credenciais criptografadas das integrações por restaurante.
RAPIDEX_INTEGRATION_SECRET=

# Mercado Pago dos restaurantes (OAuth por vendedor)
RAPIDEX_MP_CLIENT_ID=
RAPIDEX_MP_CLIENT_SECRET=

# WhatsApp Embedded Signup / Meta Tech Provider
RAPIDEX_META_APP_ID=
RAPIDEX_META_APP_SECRET=
RAPIDEX_META_EMBEDDED_SIGNUP_CONFIG_ID=
RAPIDEX_META_SOLUTION_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v25.0

# E-mail transacional
RESEND_API_KEY=
RAPIDEX_EMAIL_FROM=

# IA
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Legado single-number
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Legado/piloto single-seller
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
