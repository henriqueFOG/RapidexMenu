# Ambiente
RAPIDEX_ENV=homologation
RAPIDEX_PUBLIC_URL=http://localhost:3000

# Persistencia primaria da Vercel (segredo; provisionado pelo Neon)
DATABASE_URL=

# Acesso privado da homologacao
RAPIDEX_AUTH_MODE=hmg-access-code
RAPIDEX_HMG_OWNER_EMAIL=
RAPIDEX_HMG_OWNER_NAME=
RAPIDEX_HMG_ACCESS_CODE=

# Integracoes externas (opcionais ate receber credenciais oficiais)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
